{
  "manifest_version": 3,
  "name": "TicketPlus 購票小幫手",
  "version": "1.1.0",
  "description": "遠大售票（ticketplus.com.tw）購票輔助：自動選場次、快速填票數、勾選同意條款、顯示排隊狀態",
  "permissions": ["storage"],
  "host_permissions": ["https://ticketplus.com.tw/*"],
  "content_scripts": [
    {
      "matches": ["https://ticketplus.com.tw/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://ticketplus.com.tw/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TicketPlus 購票小幫手"
  }
}
